# ───────────────────────────── PostgreSQL ─────────────────────────────
POSTGRES_USER=capflow
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=capflow
POSTGRES_PORT=5432

# ───────────────────────────── API ─────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
# DATABASE_URL inside docker network points to the `postgres` service.
# For local development outside Docker, override to localhost.
DATABASE_URL=postgres://capflow:change_me_in_production@postgres:5432/capflow
CORS_ORIGIN=https://cap-flow.ru

# ───────────────────────────── Auth ─────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_random_hex_chars_replace_with_64_random_hex_chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=replace_with_another_64_random_hex_chars_replace_with_another_64_random
# COOKIE_DOMAIN unset for local dev; set to ".cap-flow.ru" in production for cross-subdomain.
# COOKIE_DOMAIN=.cap-flow.ru
COOKIE_SECURE=true
INVITE_TTL_HOURS=72
INVITE_BASE_URL=https://cap-flow.ru/invite
PASSWORD_RESET_TTL_MIN=60
PASSWORD_RESET_BASE_URL=https://cap-flow.ru/reset-password
RATE_LIMIT_LOGIN_PER_15MIN=5
IMPERSONATION_TTL_MIN=60

# ───────────────────────────── Redis ─────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ───────────────────────────── Notifications ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cap-flow.ru
RESEND_FROM_NAME=Capflow
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_MIN=15

# ───────────────────────────── Billing ─────────────────────────────
BILLING_PRICE_3M_USD=100
BILLING_PRICE_6M_USD=180
BILLING_PRICE_12M_USD=300
BILLING_GRACE_DAYS=3
BILLING_MIN_CONFIRMATIONS_TRC20=20
BILLING_MIN_CONFIRMATIONS_ERC20=12
BILLING_ADDRESS_POOL_TRC20=
BILLING_ADDRESS_POOL_ERC20=
TRONSCAN_API_KEY=

# ───────────────────────────── Upstream API keys (server-side only) ─────────────────────────────
ALCHEMY_API_KEY=
DEBANK_API_KEY=
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=
HELIUS_API_KEY=
COINSTATS_API_KEY=

QUOTA_COINGECKO_PER_DAY=2000
QUOTA_DEBANK_PER_DAY=2000
QUOTA_ALCHEMY_PER_DAY=5000
QUOTA_ETHERSCAN_PER_DAY=5000

CACHE_PRICE_TTL_SEC=300
CACHE_BALANCE_TTL_SEC=60

# ───────────────────────────── Web ─────────────────────────────
# Vite reads VITE_* at build-time only.
VITE_API_URL=/api

# ───────────────────────────── Caddy ─────────────────────────────
# Production domain. For local HTTP-only override to ":80".
CADDY_DOMAIN=cap-flow.ru
# Required by Let's Encrypt for cert issuance + expiry notices.
CADDY_ACME_EMAIL=admin@cap-flow.ru
