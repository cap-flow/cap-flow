# =============================================================================
# Capflow — production environment template
# =============================================================================
# Copy to `.env` at the monorepo root on the production host:
#
#   cp .env.prod.example .env
#   chmod 600 .env
#
# Then fill in every value marked [REQUIRED]. Values marked [OPTIONAL] can
# stay blank — the corresponding feature will degrade gracefully (e.g. email
# falls back to stdout if RESEND_API_KEY is empty).
#
# Compose loads this file via `env_file: ../.env` on api/worker/migrate.
# Do NOT commit the filled `.env` — it contains secrets.
# =============================================================================


# ─────────────────────────── PostgreSQL ────────────────────────────
# Used by the `postgres` service (initdb) and by DATABASE_URL below.
POSTGRES_USER=capflow
POSTGRES_PASSWORD=                       # [REQUIRED] generate: openssl rand -base64 32
POSTGRES_DB=capflow
POSTGRES_PORT=5432


# ─────────────────────────── API runtime ───────────────────────────
NODE_ENV=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000

# [REQUIRED] DSN that points to the in-network `postgres` service.
# User/password must match POSTGRES_USER/POSTGRES_PASSWORD above.
DATABASE_URL=postgres://capflow:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/capflow

# [REQUIRED] Comma-separated list of origins allowed to call /api/*.
# Production: only the apex domain over HTTPS.
CORS_ORIGIN=https://cap-flow.ru


# ─────────────────────────── Auth (JWT + cookie session) ───────────
# [REQUIRED] 64+ hex chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Cookie scoping. Set to the apex (with leading dot) so the session is
# shared across any future subdomains (api.cap-flow.ru, admin.cap-flow.ru).
COOKIE_DOMAIN=.cap-flow.ru
COOKIE_SECURE=true                       # MUST stay true in production (HTTPS only)


# ─────────────────────────── Invites & password reset ──────────────
INVITE_TTL_HOURS=72
INVITE_BASE_URL=https://cap-flow.ru/invite
PASSWORD_RESET_TTL_MIN=60
PASSWORD_RESET_BASE_URL=https://cap-flow.ru/reset-password
RATE_LIMIT_LOGIN_PER_15MIN=5
IMPERSONATION_TTL_MIN=60


# ─────────────────────────── Redis ─────────────────────────────────
# In-cluster URL — points to the `redis` service. Do not expose externally.
REDIS_URL=redis://redis:6379
REDIS_PORT=6379


# ─────────────────────────── Notifications ─────────────────────────
# Email via Resend. If RESEND_API_KEY is empty, email "delivery" prints
# to stdout (dev stub) — useful only for smoke tests, not for users.
RESEND_API_KEY=                          # [OPTIONAL] https://resend.com/api-keys
RESEND_FROM_EMAIL=noreply@cap-flow.ru
RESEND_FROM_NAME=Capflow

# Telegram bot username (without @). Empty → start-link becomes opaque.
TELEGRAM_BOT_USERNAME=                   # [OPTIONAL] e.g. CapflowBot
TELEGRAM_LINK_TTL_MIN=15
# HTTP(S)/SOCKS proxy for api.telegram.org when geoblocked (RU/CIS).
# Format: http://user:pass@host:port or socks5://host:port
# Admin can override at runtime via /admin/integrations → telegram_proxy.
TELEGRAM_BOT_HTTPS_PROXY=                # [OPTIONAL]


# ─────────────────────────── Billing (Phase 8 — crypto invoices) ───
BILLING_PRICE_3M_USD=100
BILLING_PRICE_6M_USD=180
BILLING_PRICE_12M_USD=300
BILLING_GRACE_DAYS=3
BILLING_MIN_CONFIRMATIONS_TRC20=20
BILLING_MIN_CONFIRMATIONS_ERC20=12

# Comma-separated pre-generated receive addresses. Empty disables that rail.
BILLING_ADDRESS_POOL_TRC20=              # [OPTIONAL]
BILLING_ADDRESS_POOL_ERC20=              # [OPTIONAL]

TRONSCAN_API_KEY=                        # [OPTIONAL] required if BILLING_ADDRESS_POOL_TRC20 set


# ─────────────────────────── Upstream provider keys ────────────────
# Server-only — never sent to the browser. The frontend talks to
# /api/v1/upstream/<provider>/* which injects these keys on the way out.
ALCHEMY_API_KEY=                         # [REQUIRED] EVM RPC + token API
DEBANK_API_KEY=                          # [REQUIRED] EVM portfolio + history
ETHERSCAN_API_KEY=                       # [REQUIRED] EVM tx unified API (v2)
HELIUS_API_KEY=                          # [REQUIRED] Solana RPC + history
COINGECKO_API_KEY=                       # [OPTIONAL] free tier works without
COINSTATS_API_KEY=                       # [OPTIONAL] multi-chain unified API

# Per-user upstream quotas (mainly logged for now — hard-enforced in Phase 7).
QUOTA_COINGECKO_PER_DAY=2000
QUOTA_DEBANK_PER_DAY=2000
QUOTA_ALCHEMY_PER_DAY=5000
QUOTA_ETHERSCAN_PER_DAY=5000


# ─────────────────────────── Cache TTLs (seconds) ──────────────────
CACHE_PRICE_TTL_SEC=300
CACHE_BALANCE_TTL_SEC=60


# ─────────────────────────── Web (Vite build-time) ─────────────────
# Vite freezes VITE_* into the bundle at build time, so changing this
# requires rebuilding `web`. `/api` is correct under the Caddy reverse
# proxy — same-origin requests.
VITE_API_URL=/api


# ─────────────────────────── Caddy (edge / TLS) ────────────────────
# [REQUIRED] Apex domain. Caddy will obtain a Let's Encrypt cert for it.
CADDY_DOMAIN=cap-flow.ru
# [REQUIRED] Contact email — used by ACME for renewal/expiry notices.
CADDY_ACME_EMAIL=admin@cap-flow.ru


# ─────────────────────────── Image tags ────────────────────────────
# DO NOT set these here in CI-driven deploys.
#
# `.github/workflows/deploy.yml` writes `/opt/cap-flow/.env.images` on
# every deploy with the freshly-built GHCR tags and runs:
#   docker compose --env-file .env --env-file .env.images ...
# so `.env.images` always wins over `.env` for these two vars.
#
# Only uncomment + set when running compose by hand for a local prod-
# like smoke test (no `.env.images` present):
# API_IMAGE=cap-flow-api:latest
# WEB_IMAGE=cap-flow-web:latest
