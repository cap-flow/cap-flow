# Edge reverse proxy for cap-flow.ru.
# Caddy auto-provisions HTTPS via Let's Encrypt when CADDY_DOMAIN is a real hostname
# and ports 80 + 443 are reachable from the public internet.
{
	email {$CADDY_ACME_EMAIL}
}

# www → apex redirect (preserves path + query, 308 permanent).
www.{$CADDY_DOMAIN} {
	redir https://{$CADDY_DOMAIN}{uri} permanent
}

{$CADDY_DOMAIN} {
	encode zstd gzip

	header {
		# HSTS once HTTPS is confirmed working. Pin = 1 year. Add
		# `preload` after submitting to hstspreload.org.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"

		# CSP for the SPA.
		#
		# L6 (2026-05-14): tightened `img-src` from `https:` (any HTTPS
		# host) to an explicit allow-list of CDNs we actually use for
		# token logos / protocol icons. Wildcard `https:` enabled the
		# class of attacks where a 1×1-pixel beacon to attacker.example
		# could ride on any user-supplied URL we ever render — narrows
		# the surface even though we don't currently render user URLs.
		# Also lifts Mozilla Observatory rating from B to A-range.
		#
		# When adding a new asset host:
		#   1. open the page in DevTools → Network → filter "Img"
		#   2. note any blocked requests
		#   3. add the host here (or its bare domain with wildcard
		#      subdomain prefix if the CDN spreads across many sub-
		#      hostnames)
		#
		# Hosts list (curated):
		#   debank        — static.debank.com (token + protocol logos)
		#   coingecko     — assets.coingecko.com
		#   coinstats     — static.coinstats.app
		#   defillama     — icons.llamao.fi, defillama-datasets pages
		#   tronscan      — coin.top.aws.tronscan.org (TRC20 logos)
		#   helius        — cdn.helius-rpc.com (Solana token logos via DAS)
		#   jupiter       — static.jup.ag (Jupiter portfolio icons)
		#   aave/morpho   — *.aave.com, app.morpho.org
		#   ipfs          — *.ipfs.io / cf-ipfs.com (NFT metadata)
		#
		# If you need to widen temporarily, set `img-src 'self' data: https:`
		# to debug, then re-tighten before merging.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://static.debank.com https://assets.coingecko.com https://static.coinstats.app https://icons.llamao.fi https://*.llama.fi https://coin.top.aws.tronscan.org https://cdn.helius-rpc.com https://static.jup.ag https://*.ipfs.io https://cf-ipfs.com https://*.aave.com https://*.app.morpho.org; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}

	# API + upstream-proxy routes. Preserve credentials/cookies on
	# WebSocket-less plain HTTP; Caddy does this by default but we make
	# it explicit by NOT setting `header_up` overrides that would strip
	# Authorization or Cookie.
	handle /api/* {
		reverse_proxy 127.0.0.1:3100
	}

	# External read-only API proxies — зеркало dev-proxy из
	# apps/web/vite.config.ts. Без них эти top-level пути попадают в
	# SPA-catch-all (`handle {}` ниже) и возвращают index.html вместо
	# JSON → ломаются исторические цены DefiLlama (Velodrome/Aerodrome
	# gauge cost basis = 0 на проде), список протоколов, CoinGecko.
	# Все три — публичные keyless API.
	handle /defillama/* {
		uri strip_prefix /defillama
		reverse_proxy https://coins.llama.fi {
			header_up Host coins.llama.fi
		}
	}
	handle /llamaprotos/* {
		uri strip_prefix /llamaprotos
		reverse_proxy https://api.llama.fi {
			header_up Host api.llama.fi
		}
	}
	handle /coingecko/* {
		uri replace /coingecko /api/v3
		reverse_proxy https://api.coingecko.com {
			header_up Host api.coingecko.com
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}

	log {
		output stdout
		format console
	}
}

# Legacy node service that pre-dates cap-flow on the same VPS. It only
# binds to 127.0.0.1:3000 (loopback), so the public path goes through
# this Caddy instance — possible because caddy runs with
# `network_mode: host` in docker-compose.yml.
old.{$CADDY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output stdout
		format console
	}
}
